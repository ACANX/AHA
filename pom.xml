<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.acanx.module</groupId>
    <artifactId>aha</artifactId>
    <!--
        版本号写占位符、实体值在下方 <properties>/<revision>（CI-friendly versions）：
        这样 8 个子模块只需写 <parent><version>${revision}</version>，改版本时只改一处。
        注意：不 flatten 时 install/deploy 出去的 POM 里会残留字面量 ${revision}，
        因此下方 build 区配有 flatten-maven-plugin（见 TD-00016 §A）。
    -->
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>AHA</name>
    <description>AHA Agent Harness</description>
    <url>https://github.com/ACANX/AHA</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>acanx</id>
            <name>acanx</name>
            <email>acanx@acanx.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ACANX/AHA.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ACANX/AHA.git</developerConnection>
        <url>https://github.com/ACANX/AHA</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>aha-common</module>
        <module>aha-extension-api</module>
        <module>aha-core</module>
        <module>aha-tool</module>
        <module>aha-cli</module>
        <module>aha-desktop</module>
    </modules>

    <properties>
        <!--
            版本号：**机器侧唯一来源**（权威源将来是根目录 version 文件，见 TD-00016 §H）。
            子模块的 <parent><version> 和本 POM 的 <version> 都引用 ${revision}，
            因此改版本时只改这一行（不再逐个改 9 个 POM）。
            IDE（IDEA）能解析根 POM 里的这个属性，不会出现未解析报错。
        -->
        <revision>0.1.1</revision>

        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>

        <!--
            构建版本：正式发版等于 project.version；PR 合并到 dev 后由工作流传入
            -Daha.build.version=<a.b.c.PPPPP>（如 0.1.1.00046），写进 version.properties 的 build 项，
            供 GUI「关于」与 CLI 启动页 / -V 显示，目的是拿到精确版本便于排查（issue #46）。
            注意：**不要**在子模块里重复定义，否则模块自身的 <properties> 会赢过父 POM。
        -->
        <aha.build.version>${project.version}</aha.build.version>

        <javafx.version>25</javafx.version>
        <!--
            OpenJFX 平台分类器。取值由下方 javafx-* profile 按当前操作系统/架构设定，模块里
            只写 <classifier>${javafx.platform}</classifier>，不出现平台字面量。

            默认值故意填一个**不存在的分类器**：未被任何 profile 覆盖的平台（如 Windows ARM，
            Central 上根本没有 win-aarch64）会以「找不到 javafx-*-25-unsupported.jar」明确失败，
            而不是静默拿到错平台的原生库。

            应急覆盖：-Djavafx.platform=<win|linux|mac|linux-aarch64|mac-aarch64>
            （命令行属性优先级高于 profile 属性）。
        -->
        <javafx.platform>unsupported</javafx.platform>
        <jackson.version>3.2.3</jackson.version>
        <picocli.version>4.7.7</picocli.version>
        <jline.version>4.4.6</jline.version>
        <sqlite.version>3.53.4.0</sqlite.version>
        <slf4j.version>2.0.20</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.24.0</mockito.version>
        <testfx.version>4.0.18</testfx.version>
        <jacoco.version>0.8.15</jacoco.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <assembly.plugin.version>3.8.0</assembly.plugin.version>
        <!-- 版本占位符解析插件（CI-friendly versions），交 Dependabot 跟踪 -->
        <flatten.plugin.version>1.8.0</flatten.plugin.version>
        <!-- 原生镜像（试验性）：两套平行管线——桌面端 aha-desktop-native（见
             Docs/Design/DesktopNativeDesign.md）与 CLI aha-cli-native（见
             Docs/Design/CliNativeDesign.md） -->
        <exec.plugin.version>3.5.1</exec.plugin.version>
        <dependency.plugin.version>3.9.0</dependency.plugin.version>
        <resources.plugin.version>3.3.1</resources.plugin.version>
        <clean.plugin.version>3.4.1</clean.plugin.version>
        <!-- 重复代码率检查：报告由 `pmd:cpd` 生成，阈值由 bin/CheckDuplication.py 判定 -->
        <pmd.plugin.version>3.28.0</pmd.plugin.version>

        <!--
            原生编译总开关：**默认关闭**，默认值的唯一来源就在这里。

            约定（强制）：原生编译只在专用 profile 下进行（desktop-native / cli-native，
            需要新 JDK 时再加 native-jdk27）。默认构建的验收标准只有一条——**能编译、能打 jar、
            不报错**；能不能运行不属于默认构建的职责。价值在于「没装工具链的环境」：
            默认路径一旦依赖 GraalVM，构建失败就会从「代码问题」变成「环境问题」，
            而后者极难在别人的机器上复现。

            覆盖点有两个，缺一不可：
              ① desktop-native / cli-native profile（**同一个 POM** 内覆盖为 false，有效）；
              ② CI 显式 -Dnative.skip=false（命令行 -D 优先级最高，兜底）。

            ⚠ **不要在子模块里重复定义它**：模块自身的 <properties> 会**赢过**父 POM 里
            profile 注入的属性，于是 profile 的 false 不生效、native-image 被静默跳过。
            2026-10-08 的实测症状是「构建成功、零产物、零报错」，CI 全绿却什么都没编出来。
        -->
        <native.skip>true</native.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AHA 内部模块 -->
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-extension-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.acanx.module.aha</groupId>
                <artifactId>aha-desktop</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方 -->

            <!--
                OpenJFX：原生库随分类器发布，因此**每个需要的工件都要显式带分类器**——
                带分类器的工件在依赖树里拉进来的传递依赖是「无分类器」版本（即没有原生库的
                空壳），只声明 javafx-controls 会得到一个跑不起来的组合。实测见
                Docs/Design/DesktopDesign.md。
            -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-shell-jline3</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j2-impl</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>

            <!-- 测试 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${assembly.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd.plugin.version}</version>
                    <configuration>
                        <!-- 只统计主源码；最小 token 数决定「多长才算重复」 -->
                        <minimumTokens>100</minimumTokens>
                        <includeTests>false</includeTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${dependency.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${clean.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${javadoc.plugin.version}</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <docencoding>UTF-8</docencoding>
                        <charset>UTF-8</charset>
                        <locale>zh_CN</locale>
                        <doclint>none</doclint>
                        <failOnError>false</failOnError>
                        <quiet>true</quiet>
                        <additionalOptions>
                            <additionalOption>-Xdoclint:none</additionalOption>
                        </additionalOptions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                版本占位符解析：把 ${revision} 落成实际版本后再 install / deploy。

                不 flatten 时，装出去的 POM 里是**字面量** ${revision}，下游解析失败。
                Maven 4 已内置 consumer POM 承担同一职责（比 flatten 更彻底：连 build 段
                都剥离），但本仓库同时保留 Maven 3.9.x 兼容基线（Compat.yml），3.9.x 没有
                consumer POM——只要兼容线还在，flatten 就必须留（见 TD-00016「与 Maven 4 的
                分期决策」）。

                flattenMode=resolveCiFriendliesOnly：只解析 ${revision} 这类 CI-friendly
                属性，其余内容原样保留，不在本地磁盘上做全量最小化。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- 0.1 阶段尚未实现的占位与桌面端 -->
                        <exclude>com/acanx/module/aha/desktop/**</exclude>
                        <!-- 插件运行时属于 0.3（阶段八），0.1 不纳入覆盖率门禁 -->
                        <exclude>com/acanx/module/aha/core/extension/**</exclude>
                        <!-- MCP 适配器为 0.2 占位 -->
                        <exclude>com/acanx/module/aha/core/mcp/**</exclude>
                        <!-- 交互式与网络命令依赖真实 TTY / 供应商，由手工端到端验收覆盖 -->
                        <exclude>com/acanx/module/aha/cli/ChatCommand*</exclude>
                        <exclude>com/acanx/module/aha/cli/RunCommand*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        OpenJFX 平台分类器（0.2 桌面端）

        为什么用 profile 而不是在模块里写死分类器：JavaFX 的原生库按平台发布成不同的
        分类器工件（Central 上 javafx-controls:25 只有 linux / linux-aarch64 / mac /
        mac-aarch64 / win 五种），构建时必须解析到「当前平台」那一份；而 jpackage
        不能交叉编译，每个平台的包只能由该平台的 runner 产出（见 BuildSpec.md 第 4.1 节）。

        激活条件的写法（均已在 Maven 4.0.0-rc-7 与 3.9.11 上实测）：

        - Windows 用 <family>windows</family>；macOS 用 <family>mac</family>。
        - Linux **不用** <family>unix</family>——实测在本机 Linux 上它命中，而 unix 在部分
          Maven/JDK 组合下对 macOS 同样成立，用它会让两个平台撞车；改判 <name>Linux</name>。
        - 架构判据用 aarch64，**不要写 x86_64**：Maven 的 os.arch 在本机是 amd64（实测
          x86_64 条件不命中、amd64 命中），因此 x86 侧一律用取反 <arch>!aarch64</arch>，
          既覆盖所有非 ARM 变体，也不与 JDK 的命名差异耦合。取反写法实测有效。
        - Central 上没有 win-aarch64，Windows ARM 不在支持范围（会用上面的 unsupported 兜底值失败）。
    -->
    <profiles>
        <profile>
            <id>javafx-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>!aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac-aarch64</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>!aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-linux-aarch64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux-aarch64</javafx.platform>
            </properties>
        </profile>


        <!--
            桌面端原生镜像（试验性，默认不在反应堆里）：见 aha-desktop-native 与
            Docs/Design/DesktopNativeDesign.md。常规构建看不到这个模块。
        -->
        <profile>
            <id>desktop-native</id>
            <modules>
                <module>aha-desktop-native</module>
            </modules>
            <properties>
                <!--
                    只有本 profile 激活时才允许调用 native-image。
                    这样「模块被带进反应堆」与「真的去编原生镜像」是两件事，
                    误入反应堆也不会要求环境具备 GraalVM。
                -->
                <native.skip>false</native.skip>
            </properties>
        </profile>

        <!--
            CLI 原生镜像（试验性，默认不在反应堆里）：见 aha-cli-native 与
            Docs/Design/CliNativeDesign.md。常规构建看不到这个模块。
            与 desktop-native 是**两个独立的 profile**：可以只编一个，也可以两个一起编。
        -->
        <profile>
            <id>cli-native</id>
            <modules>
                <module>aha-cli-native</module>
            </modules>
            <properties>
                <!--
                    同 desktop-native：只有本 profile 激活时才允许调用 native-image。
                    默认值的唯一来源仍是根 POM 的 <properties>（true），
                    子模块不得再写自己的默认值（会赢过 profile 注入，造成静默跳过）。
                -->
                <native.skip>false</native.skip>
            </properties>
        </profile>
    </profiles>

    <!--
        ── 桌面端原生镜像（试验性，默认不在反应堆里） ────────────────────────────────
        把 aha-desktop 的 JVM 产物再编译成 GraalVM native-image 二进制（win / linux / macos）。

        为什么用 profile 而不是直接写进 <modules>：原生镜像的构建比 JVM 构建脆得多
        （JavaFX 原生库、反射与资源清单、各平台工具链差异），挂在常规反应堆上意味着
        一次实验性失败会挡住 `./mvnw clean verify`、Gate、Compat 全部流程。
        放在 profile 里，常规构建完全看不到它；只有显式 `-Pdesktop-native` 才加入：

            ./mvnw -Pdesktop-native -pl aha-desktop-native -am package -DskipTests

        工作流见 .github/workflows/DesktopNative.yml，设计与风险见
        Docs/Design/DesktopNativeDesign.md。
    -->

    <!--
        ── CLI 原生镜像（试验性，默认不在反应堆里） ────────────────────────────────
        把 aha-cli 的 JVM 产物再编译成 GraalVM native-image 二进制（win / linux / macos）。
        与桌面端那套是**平行**关系：同一套隔离约定，各自一个模块、一个工作流、一份参数文件。

            ./mvnw -Pcli-native -pl aha-cli-native,aha-cli -am package -DskipTests

        工作流见 .github/workflows/CliNative.yml，设计与风险见
        Docs/Design/CliNativeDesign.md。
    -->
</project>
