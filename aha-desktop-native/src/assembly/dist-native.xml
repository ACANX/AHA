<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist-native</id>
    <formats>
        <format>zip</format>
    </formats>
    <!-- 内容直接铺到包里：解压就能见到可执行文件，不再多一层目录 -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <!--
        原生镜像包的内容刻意很少：只有一个可执行文件 + 说明 + 构建参数。

        不放 lib/：原生镜像的依赖已经**静态编进可执行文件**，这也是它与 jar 模式包的区别。
        放 native-image-args.txt 是为了「这个二进制是怎么编出来的」永远可查——
        原生镜像的参数会反复迭代，事后能对上账比省几 KB 重要得多。
    -->
    <fileSets>
        <!-- 可执行文件：必须 0755，否则 Linux / macOS 上下载后不能直接双击运行 -->
        <fileSet>
            <directory>${native.image.workdir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <!-- Windows 上 native-image 产出 .exe；其它平台没有后缀。两个都列，命中一个。 -->
                <include>${aha.native.name}</include>
                <include>${aha.native.name}.exe</include>
            </includes>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>

        <!-- 说明书与构建参数：普通文件权限（首版把 README 也标成 755 了，不该那样） -->
        <fileSet>
            <directory>${native.image.workdir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>README.txt</include>
                <!--
                    构建报告（native-image 的「emit build report」参数产出，
                    真实文件名是 <可执行名>-build-report.html）**不打进本包**。

                    2026-10-08 定案（issue #29）：报告裸文件 34~36 MB，
                    而且它与二进制是两类东西——报告是给人分析用的，二进制是给人运行的。
                    因此改由工作流单独打成**独立发布包**：
                        AHA-Desktop-Native-Report-<版本>-<系统>-<架构>-jdk<版本>.zip
                    与镜像包同族命名、同批挂到发布页，下载时一眼能对上同一版本。
                    包里含报告 + 原生镜像参数 + 可达性元数据（一组对账材料）。

                    通配一律写 *build-report.*：真实文件名前缀是**可执行名**，
                    不是 build-report——按 build-report* 写会静默漏掉（实测漏过）。
                -->
                <!-- 可达性元数据（真实来源在 aha-desktop，构建时复制过来一份） -->
                <include>reachability-metadata.json</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <!--
            构建参数原样附上（不带过滤）：原生镜像的参数会反复迭代，
            「这个二进制是怎么编出来的」必须事后可查。
            两份都带上——JDK25 与 JDK27 分支的差异就在这两份文件的 diff 里。
        -->
        <fileSet>
            <directory>${project.basedir}/src/native</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>native-image-args.txt</include>
                <include>native-image-args-jdk27.txt</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <fileSet>
            <directory>${project.parent.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>LICENSE</include>
                <include>CHANGELOG.md</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <!--
            自更新换装 helper（issue #51 §4.5）：**必须与 jar 便携包一样随包分发**。

            2026-10-16 代码审查 P0 发现：这里原来没有它，于是「原生形态自更新」在
            「复制 helper」那一步必然失败（`UpdateLauncher.installHelpers` 抛「该包不完整」），
            而设计 §8.2 第 9 项正是要给真实机验证这条路径 —— 验证前就注定是红的。

            两个文件都不带版本号：计划文件才是唯一入参，换版本不用改脚本。

            issue #381：这里以前写着「非 Windows 包里带这两个 .cmd/.ps1 属于暂时用不上」，
            现在改为**按平台分发**：描述符仍收（Windows 包需要），POSIX 包由出包腿
            （`PrunePlatformScripts.py`）在生成包内清单之前裁掉，用户不再看到用不上的脚本。
        -->
        <fileSet>
            <directory>${project.parent.basedir}/Dist</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>apply-update.cmd</include>
                <include>AhaApplyUpdate.ps1</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
