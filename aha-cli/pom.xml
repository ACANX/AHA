<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acanx.module</groupId>
        <artifactId>aha</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.acanx.module.aha</groupId>
    <artifactId>aha-cli</artifactId>
    <name>AHA-CLI</name>
    <description>命令行入口（picocli + JLine）</description>

    <properties>
        <!-- fat jar 的 Main-Class（issue #200）。CLI 入口本身没有继承 Application，
             可以直接当入口；桌面端才有转发类 Launcher（避开 JavaFX 的模块化检查）。 -->
        <mainClass>com.acanx.module.aha.cli.AhaCli</mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-shell-jline3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            log4j-core 为 compile scope：CLI 是组合根，需要它在运行时
            按 Aha.Logging 程序化配置 appender 与级别（见 LoggingSetup）。
            aha-core 仍将日志实现约束在 runtime，只依赖 slf4j-api，
            以保证核心不绑定具体日志实现。
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                picocli 的 native-image 反射元数据（构建期生成）。

                为什么用注记处理器而不是手写清单：picocli 的反射面不小，且**跟着注解变**——
                子命令靠 `@Command(subcommands=…)` 反射实例化、`@Option` / `@Parameters`
                字段靠反射注入、类型转换器也要靠反射找。手写一份清单，一旦新增 / 重命名
                子命令或选项就漏一条，而症状是**运行期**才有的（构建成功、一执行就崩）。
                `picocli-codegen` 直接扫编译单元，生成的
                `META-INF/native-image/picocli-generated/reflect-config.json` 随 aha-cli.jar
                进 classpath，native-image 自动读取——单一来源、与源码同步。

                只作用于编译期：处理器不生成任何业务字节码，只写一份 JSON。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                单体 fat jar（issue #200）：把本项目各模块与全部 runtime 依赖（含
                OpenJFX 本平台分类器、sqlite-jdbc、jline）打进一个可执行 jar。
                产物名 = ${project.build.finalName}.jar（本阶段仍带版本号；改为不带版本
                见 #200 的后续阶段）。

                三条必须的 filter（上游 LegionFanControl 已验证）：
                  1. 排除 module-info.class（含 META-INF/versions/ 下的）——
                     JPMS 描述符留在 classpath 模式下会与 fat jar 冲突；
                  2. 排除 META-INF/*.SF|DSA|RSA —— 原 jar 的签名对合并后的 jar 无意义，
                     留着会让 java -jar 报「签名校验失败」；
                  3. 合并 META-INF/services（picocli / JLine / SLF4J / Jackson 都靠它）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                把 shade 产出的 fat jar 复制到仓库根 Dist/（供 CI 打快照包 / 本地取件）。
                本 execution **必须声明在 shade 之后**：同一 package 阶段内按声明顺序执行，
                否则复制到的是 shade 覆盖前的原始 jar。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-fatjar-to-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${maven.multiModuleProjectDirectory}/Dist</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                让 `mvn clean` 清掉 Dist/ 里由构建产生的文件。

                必要性：assembly 只覆盖同名文件，旧版本的依赖 jar 会一直留在
                Dist/lib。JPMS 下一个模块出现两个版本是致命错误
                （java.lang.module.FindException: Two versions of module ...），
                依赖升级后重新构建出的发行包会直接启不来。

                只列文件、不写 `**/*`：目录本身留着，否则在 WSL 的 9p 挂载上
                “删空目录”会 Permission denied，连带把 clean 整个搞失败。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <!--
                        文件被占用时不让整个 clean 失败：正在运行的 AHA 实例会锁住
                        Dist/lib 里自己的 jar（Windows 上尤其严格）。

                        安全前提：被锁的必然是**当前版本**的同名文件，assembly 会直接覆盖；
                        真正需要清理的是旧版本残留，而那些文件没人占用、能正常删掉。
                    -->
                    <failOnError>false</failOnError>
                    <filesets>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/Dist</directory>
                            <includes>
                                <include>*.md</include>
                                <include>bin/*</include>
                                <include>lib/*.jar</include>
                            </includes>
                            <excludes>
                                <!--
                                    命令速查已纳入版本控制（.gitignore 里放行），因此不能跟着
                                    `clean` 一起删掉，否则工作区每次 clean 都显示“文件被删除”。
                                    它的内容仍由 package 阶段的 assembly 重新写回。
                                -->
                                <exclude>README.commands.md</exclude>
                            </excludes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!--
                发行包：将 aha-cli 自身、全部模块与第三方依赖收集到 lib/，
                并附带 bin/ 启动脚本，生成到项目根 Dist/。
                布局：Dist/{bin,lib} —— bin/Aha.sh 取 $DIR/../lib。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/dist.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- 平铺到项目根 Dist/，使 bin/Aha.sh 的 $DIR/../lib 成立 -->
                            <!--
                                注意：这里**刻意**是仓库根，不是 ${maven.multiModuleProjectDirectory}/Dist。

                                原因：CLI 的 assembly 描述符（src/assembly/dist.xml）内部把内容铺到
                                `Dist/`（`bin/` + `lib/` + 三个文档），组装结果就是「仓库根的 Dist/」。
                                若在这里再加一层 /Dist，产出会变成 `Dist/Dist/…`。
                                也就是说：**CLI 的输出本来就在 Dist/ 里**，其余模块（桌面端、原生镜像）
                                才是通过本元素直接指向 /Dist 的——口径一致，写法不同。
                            -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                            <finalName>Dist</finalName>
                            <!-- dir 格式产物不可安装/部署，关闭 attach 以消除警告 -->
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
