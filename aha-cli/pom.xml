<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acanx.module</groupId>
        <artifactId>aha</artifactId>
        <version>0.1.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.acanx.module.aha</groupId>
    <artifactId>aha-cli</artifactId>
    <name>AHA-CLI</name>
    <description>命令行入口（picocli + JLine）</description>

    <dependencies>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-shell-jline3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            log4j-core 为 compile scope：CLI 是组合根，需要它在运行时
            按 Aha.Logging 程序化配置 appender 与级别（见 LoggingSetup）。
            aha-core 仍将日志实现约束在 runtime，只依赖 slf4j-api，
            以保证核心不绑定具体日志实现。
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                picocli 的 native-image 反射元数据（构建期生成）。

                为什么用注记处理器而不是手写清单：picocli 的反射面不小，且**跟着注解变**——
                子命令靠 `@Command(subcommands=…)` 反射实例化、`@Option` / `@Parameters`
                字段靠反射注入、类型转换器也要靠反射找。手写一份清单，一旦新增 / 重命名
                子命令或选项就漏一条，而症状是**运行期**才有的（构建成功、一执行就崩）。
                `picocli-codegen` 直接扫编译单元，生成的
                `META-INF/native-image/picocli-generated/reflect-config.json` 随 aha-cli.jar
                进 classpath，native-image 自动读取——单一来源、与源码同步。

                只作用于编译期：处理器不生成任何业务字节码，只写一份 JSON。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                让 `mvn clean` 清掉 dist/ 里由构建产生的文件。

                必要性：assembly 只覆盖同名文件，旧版本的依赖 jar 会一直留在
                dist/lib。JPMS 下一个模块出现两个版本是致命错误
                （java.lang.module.FindException: Two versions of module ...），
                依赖升级后重新构建出的发行包会直接启不来。

                只列文件、不写 `**/*`：目录本身留着，否则在 WSL 的 9p 挂载上
                “删空目录”会 Permission denied，连带把 clean 整个搞失败。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <!--
                        文件被占用时不让整个 clean 失败：正在运行的 AHA 实例会锁住
                        dist/lib 里自己的 jar（Windows 上尤其严格）。

                        安全前提：被锁的必然是**当前版本**的同名文件，assembly 会直接覆盖；
                        真正需要清理的是旧版本残留，而那些文件没人占用、能正常删掉。
                    -->
                    <failOnError>false</failOnError>
                    <filesets>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/dist</directory>
                            <includes>
                                <include>*.md</include>
                                <include>bin/*</include>
                                <include>lib/*.jar</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!--
                发行包：将 aha-cli 自身、全部模块与第三方依赖收集到 lib/，
                并附带 bin/ 启动脚本，生成到项目根 dist/。
                布局：dist/{bin,lib} —— bin/Aha.sh 取 $DIR/../lib。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/dist.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- 平铺到项目根 dist/，使 bin/Aha.sh 的 $DIR/../lib 成立 -->
                            <!--
                                注意：这里**刻意**是仓库根，不是 ${maven.multiModuleProjectDirectory}/dist。

                                原因：CLI 的 assembly 描述符（src/assembly/dist.xml）内部把内容铺到
                                `dist/`（`bin/` + `lib/` + 三个文档），组装结果就是「仓库根的 dist/」。
                                若在这里再加一层 /dist，产出会变成 `dist/dist/…`。
                                也就是说：**CLI 的输出本来就在 dist/ 里**，其余模块（桌面端、原生镜像）
                                才是通过本元素直接指向 /dist 的——口径一致，写法不同。
                            -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                            <finalName>dist</finalName>
                            <!-- dir 格式产物不可安装/部署，关闭 attach 以消除警告 -->
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
