<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acanx.module</groupId>
        <artifactId>aha</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.acanx.module.aha</groupId>
    <artifactId>aha-cli</artifactId>
    <name>AHA-CLI</name>
    <description>命令行入口（picocli + JLine）</description>

    <properties>
        <!-- fat jar 的 Main-Class（issue #200）。CLI 入口本身没有继承 Application，
             可以直接当入口；桌面端才有转发类 Launcher（避开 JavaFX 的模块化检查）。 -->
        <mainClass>com.acanx.module.aha.cli.AhaCli</mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-shell-jline3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            log4j-core 为 compile scope：CLI 是组合根，需要它在运行时
            按 Aha.Logging 程序化配置 appender 与级别（见 LoggingSetup）。
            aha-core 仍将日志实现约束在 runtime，只依赖 slf4j-api，
            以保证核心不绑定具体日志实现。
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                picocli 的 native-image 反射元数据（构建期生成）。

                为什么用注记处理器而不是手写清单：picocli 的反射面不小，且**跟着注解变**——
                子命令靠 `@Command(subcommands=…)` 反射实例化、`@Option` / `@Parameters`
                字段靠反射注入、类型转换器也要靠反射找。手写一份清单，一旦新增 / 重命名
                子命令或选项就漏一条，而症状是**运行期**才有的（构建成功、一执行就崩）。
                `picocli-codegen` 直接扫编译单元，生成的
                `META-INF/native-image/picocli-generated/reflect-config.json` 随 aha-cli.jar
                进 classpath，native-image 自动读取——单一来源、与源码同步。

                只作用于编译期：处理器不生成任何业务字节码，只写一份 JSON。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                单体 fat jar（issue #200）：把本项目各模块与全部 runtime 依赖
                （sqlite-jdbc、jline、log4j2、Jackson…）打进一个可执行 jar。

                **必须是附带产物**（`shadedArtifactAttached=true` + classifier `standalone`）。
                默认行为（attached=false）会用 fat jar **顶替主产物**，于是：
                  * assembly 描述符的 `useProjectArtifact=true` 会把 fat jar 再收一份
                    （同一个类在包里存两遍，包体白白翻倍 —— issue #217）；
                  * `aha-cli-native` 那条线声明了对 `aha-cli` 的依赖，拿到的也会是 fat jar，
                    再叠上它自己 copy 的 runtime 依赖，classpath 上每一份都是两遍。
                客户端（assembly / native-image）要的是「模块 jar + 依赖 jar」，
                只有「便携包」要 fat jar —— 两者必须是两个工件。

                三条必须的 filter（上游 LegionFanControl 已验证）：
                  1. 排除 module-info.class（含 META-INF/versions/ 下的）——
                     JPMS 描述符留在 classpath 模式下会与 fat jar 冲突；
                  2. 排除 META-INF/*.SF|DSA|RSA —— 原 jar 的签名对合并后的 jar 无意义，
                     留着会让 java -jar 报「签名校验失败」；
                  3. 合并 META-INF/services（picocli / JLine / SLF4J / Jackson 都靠它）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 附带产物名：aha-cli-<版本>-standalone.jar（装配描述符按这个路径取） -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>standalone</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                单体 jar 不再由本 POM 单独复制：自 issue #218 起它由 assembly 直接铺到
                `Dist/aha-cli.jar`（名字去版本号与 classifier，见 src/assembly/dist.xml）。
                原先那个 `copy-fatjar-to-dist` execution（复制成 `Dist/aha-cli-<版本>.jar`）
                已随之删除 —— 同一件事只在一个地方做。
            -->
            <!--
                让 `mvn clean` 清掉 Dist/ 里由构建产生的文件。

                自 issue #218 起 CLI 包是**平铺**的（`aha-cli.jar` + `Aha.sh` / `Aha.bat`
                + 文档），清单里的 `bin/*` 与 `lib/*.jar` 只为清掉**旧形态的遗留**：
                它们不再由构建产出，但升级上来的工作区里还会有，留着会让人误以为
                包还是 JPMS 目录形态（JPMS 下同名模块出现两个版本更是致命错误
                java.lang.module.FindException）。

                只列文件、不写 `**/*`：目录本身留着，否则在 WSL 的 9p 挂载上
                “删空目录”会 Permission denied，连带把 clean 整个搞失败。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <!--
                        文件被占用时不让整个 clean 失败：正在运行的 AHA 实例会锁住
                        Dist/lib 里自己的 jar（Windows 上尤其严格）。

                        安全前提：被锁的必然是**当前版本**的同名文件，assembly 会直接覆盖；
                        真正需要清理的是旧版本残留，而那些文件没人占用、能正常删掉。
                    -->
                    <failOnError>false</failOnError>
                    <filesets>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/Dist</directory>
                            <includes>
                                <include>*.md</include>
                                <include>aha-cli.jar</include>
                                <include>bin/*</include>
                                <include>lib/*.jar</include>
                            </includes>
                            <excludes>
                                <!--
                                    命令速查已纳入版本控制（.gitignore 里放行），因此不能跟着
                                    `clean` 一起删掉，否则工作区每次 clean 都显示“文件被删除”。
                                    它的内容仍由 package 阶段的 assembly 重新写回。
                                -->
                                <exclude>README.commands.md</exclude>
                            </excludes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!--
                发行包：单体 jar（shade 的 `standalone` 附带产物）+ 启动脚本 + 文档，
                全部**平铺**到项目根 Dist/（issue #218）。
                布局：Dist/{aha-cli.jar, Aha.sh, Aha.bat, README.md, LICENSE, CHANGELOG.md}。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/dist.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- 平铺到项目根 Dist/，使 bin/Aha.sh 的 $DIR/../lib 成立 -->
                            <!--
                                注意：这里**刻意**是仓库根，不是 ${maven.multiModuleProjectDirectory}/Dist。

                                原因：CLI 的 assembly 描述符（src/assembly/dist.xml）内部把内容铺到
                                `Dist/`（`bin/` + `lib/` + 三个文档），组装结果就是「仓库根的 Dist/」。
                                若在这里再加一层 /Dist，产出会变成 `Dist/Dist/…`。
                                也就是说：**CLI 的输出本来就在 Dist/ 里**，其余模块（桌面端、原生镜像）
                                才是通过本元素直接指向 /Dist 的——口径一致，写法不同。
                            -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
                            <finalName>Dist</finalName>
                            <!-- dir 格式产物不可安装/部署，关闭 attach 以消除警告 -->
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
