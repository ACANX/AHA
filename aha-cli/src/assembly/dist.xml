<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>dir</format>
    </formats>
    <!--
        内容直接铺到 Dist/（`includeBaseDirectory=false`）。

        包内**平铺**（issue #218）：单体 jar + 启动脚本 + 四个文档，全在 Dist/ 根。
        不再有 `lib/`（依赖全在单体 jar 里），也不再单独建 `bin/`。

        改之前是 `Dist/bin` + `Dist/lib` 的 JPMS 模块路径形态；那时 `lib/` 里除了本项目
        各模块，还因为 `useProjectArtifact=true` 把 shade 出来的单体 jar 又收了一份，
        于是同一个类在包里存两遍（55MB，issue #217）。
    -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <!-- 启动脚本平铺到 Dist/ 根：解压后直接双击/执行，不需要进子目录 -->
        <fileSet>
            <directory>${project.parent.basedir}/bin</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>AhaCli.sh</include>
                <include>AhaCli.bat</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.parent.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>README.md</include>
                <include>LICENSE</include>
                <include>CHANGELOG.md</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <!--
            单体 jar：shade 的附带产物（classifier `standalone`）。落地时**刻意去掉版本号与
            classifier**，固定叫 `aha-cli.jar` —— 启动脚本、用户命令与文档因此都与版本无关，
            换版本不用改任何一处（issue #218）。
        -->
        <file>
            <source>${project.build.directory}/${project.artifactId}-${project.version}-standalone.jar</source>
            <outputDirectory>.</outputDirectory>
            <destName>aha-cli.jar</destName>
        </file>
        <!--
            命令速查随包重建：`mvnw clean` 会删掉 Dist/*.md（见 aha-cli/pom.xml 的
            maven-clean-plugin 配置），因此速查必须由 assembly 重新写回，否则一次 clean
            就消失。源文件是仓库里的 Docs/Guide/CommandCheatsheet.md，唯一来源。

            落地名刻意用 README.commands.md 而不是 README.md：README.md 是项目 README
            （上面 fileSet 复制），两者同名会互相覆盖。文件名不在 Release.yml 的打包清单里，
            因此不会进入正式发行 zip，只服务本地 Dist/。
        -->
        <file>
            <source>${project.parent.basedir}/Docs/Guide/CommandCheatsheet.md</source>
            <outputDirectory>.</outputDirectory>
            <destName>README.commands.md</destName>
        </file>
    </files>
</assembly>
