<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>dir</format>
    </formats>
    <!-- 内容直接铺到 Dist/，与 bin/Aha.sh 的 $DIR/../lib 布局一致 -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <dependencySets>
        <!--
            0.1 分发方式：JPMS 模块路径目录。
            使用本项目 artifact 自身（aha-cli）与全部 runtime 依赖，
            包括 aha-common / aha-extension-api / aha-core / aha-tool 与第三方 JAR。
        -->
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>false</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>${project.parent.basedir}/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>Aha.sh</include>
                <include>Aha.bat</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.parent.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>README.md</include>
                <include>LICENSE</include>
                <include>CHANGELOG.md</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <!--
            命令速查随包重建：`mvnw clean` 会删掉 Dist/*.md（见 aha-cli/pom.xml 的
            maven-clean-plugin 配置），因此速查必须由 assembly 重新写回，否则一次 clean
            就消失。源文件是仓库里的 Docs/Guide/CommandCheatsheet.md，唯一来源。

            落地名刻意用 README.commands.md 而不是 README.md：README.md 是项目 README
            （上面 fileSet 复制），两者同名会互相覆盖。文件名不在 Release.yml 的打包清单里，
            因此不会进入正式发行 zip，只服务本地 Dist/。
        -->
        <file>
            <source>${project.parent.basedir}/Docs/Guide/CommandCheatsheet.md</source>
            <outputDirectory>.</outputDirectory>
            <destName>README.commands.md</destName>
        </file>
    </files>
</assembly>
