<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acanx.module</groupId>
        <artifactId>aha</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.acanx.module.aha</groupId>
    <artifactId>aha-desktop</artifactId>
    <name>AHA-Desktop</name>
    <description>桌面端（OpenJFX）：0.2 起实装，0.1 为占位</description>

    <dependencies>
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-core</artifactId>
        </dependency>
        <!--
            内置工具（file / http / shell）：D-09 决策——桌面端需要工具能力，
            依赖矩阵已在 Constitution.md 第 4 条与 ModuleConvention.md 第 2 节补上
            core <- tool <- desktop 这条边。工具由 ServiceLoader 发现，故必须进本模块的
            运行时依赖，否则打包出的桌面端不带任何工具。
        -->
        <dependency>
            <groupId>com.acanx.module.aha</groupId>
            <artifactId>aha-tool</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            OpenJFX：只写 groupId/artifactId，版本与平台分类器由父 POM 的
            dependencyManagement + javafx-* profile 提供（见父 POM 的说明）。
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <classifier>${javafx.platform}</classifier>
            <!--
                排除同名 GA 的「无分类器」传递依赖：那是一堆 0 KB 的空壳 jar（无类、无
                module-info），留在 classpath 上无害，但在 module path 上会被当成自动模块
                javafx.graphics / javafx.base，与带分类器的真模块重名。排除后依赖树里
                只剩本平台的三个真 jar（实测见 Docs/Design/DesktopDesign.md）。
            -->
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <classifier>${javafx.platform}</classifier>
            <!-- 同理排除它带进来的 javafx-base 空壳（模块名 javafx.baseEmpty [auto]，
                 自动模块会让 jpackage/jlink 直接失败） -->
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                每个测试类各用独立 JVM。

                原因：配置引导测试会调用 AhaBootstrap.boot，它按设计**替换**进程级的 log4j2
                配置（换成「console(ERROR) + 文件」）。若与其它测试共用 JVM，后续用例的日志出口
                就被改掉了（曾因此让构建日志里冒出本不该出现的 ERROR 行）。
                代价是几个 JVM 启动时间，换来「测试之间互不改变对方的全局状态」。
            -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dist-desktop</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/dist-desktop.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!--
                                产物直接落到项目根，文件名带版本与平台分类器：
                                    aha-desktop-<version>-<javafx.platform>.zip
                                版本取父 POM，分类器由父 POM 的 javafx-* profile 按当前 OS/架构解析
                                —— 文件名里的平台信息来自构建期真实解析结果，不是手写常量。
                                发布工作流据此把各平台包挂到 release 页面（见 Release.yml）。
                            -->
                            <!--
                                产物统一落 Dist/：仓库根只放源码与文档，不放构建物。
                                （Dist/ 已在 .gitignore 里，且它同时是 CLI 发行目录的解包位置。）
                            -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}/Dist</outputDirectory>
                            <finalName>aha-desktop-${project.version}-${javafx.platform}</finalName>
                            <!-- zip 产物不参与部署，关闭 attach 以消除警告 -->
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
