<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist-desktop</id>
    <formats>
        <format>zip</format>
    </formats>
    <!--
        包内**平铺**（issue #218）：单体 jar + 启动脚本 + 三个文档，全在包根。
        不再有 `lib/`（依赖与本平台 OpenJFX 都在单体 jar 里），也不再单独建 `bin/`。
    -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <!-- 启动脚本平铺到包根：解压后直接双击/执行，不需要进子目录 -->
        <fileSet>
            <directory>${project.parent.basedir}/bin</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>AhaDesktop.sh</include>
                <include>AhaDesktop.bat</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.parent.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>README.md</include>
                <include>LICENSE</include>
                <include>CHANGELOG.md</include>
            </includes>
        </fileSet>
        <!--
            自更新换装 helper（issue #51 §4.5）：必须随包分发 —— App 在换装前把它复制到
            `<AHA_HOME>/update/`（放安装根之外：它会自删，也不该出现在被替换的目录里）。
            两个文件都不带版本号：计划文件才是唯一入参，换版本不用改脚本。
        -->
        <fileSet>
            <directory>${project.parent.basedir}/Dist</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>apply-update.cmd</include>
                <include>AhaApplyUpdate.ps1</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <!--
            单体 jar：shade 的附带产物（classifier `standalone`）。落地时**刻意去掉版本号与
            classifier**，固定叫 `aha-desktop.jar` —— 启动脚本、用户命令与文档因此都与版本无关，
            换版本不用改任何一处（issue #218）。
        -->
        <file>
            <source>${project.build.directory}/${project.artifactId}-${project.version}-standalone.jar</source>
            <outputDirectory>.</outputDirectory>
            <destName>aha-desktop.jar</destName>
        </file>
    </files>
</assembly>
